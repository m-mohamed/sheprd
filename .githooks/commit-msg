#!/usr/bin/env sh
set -eu

subject="$(sed -n '1p' "$1")"

case "$subject" in
  Initial\ commit)
    exit 0
    ;;
  feat:\ *|fix:\ *|docs:\ *|ci:\ *|chore:\ *|test:\ *|refactor:\ *|perf:\ *|release:\ *)
    exit 0
    ;;
esac

printf '%s\n' "error: use 'Initial commit' for the root commit or a conventional commit subject after that" >&2
exit 1
